RABBITMQ_URL=amqp://guest:guest@localhost:5672/
QDRANT_HOST=localhost
QDRANT_PORT=6333
POSTGRES_DSN=postgresql+asyncpg://rag:rag@localhost:5432/rag
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
DEEPSEEK_API_KEY=your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- LLM провайдер (deepseek | openai | anthropic) ---
# openai — любой OpenAI-совместимый chat-completions endpoint
# (OpenAI, vLLM, Ollama /v1, Together, Groq); anthropic — Messages API.
LLM_PROVIDER=deepseek
# LLM_MODEL=                   # переопределить модель провайдера
# LLM_MAX_TOKENS=500
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
EMBEDDING_MODEL=intfloat/multilingual-e5-small
COLLECTION_NAME=documents
JWT_SECRET=your-secret-key
JWT_ALGORITHM=HS256
# --- JWT hardening (опционально) ---
# JWT_SECRET_PREVIOUS=            # предыдущий секрет для ротации без даунтайма
# JWT_ALGORITHM=RS256             # асимметричная схема: приватный ключ только в auth-сервисе
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----
# JWT_ISSUER=                     # обязательные iss/aud в токенах
# JWT_AUDIENCE=rag-service
# ANONYMIZE_CONVERSATIONS=false   # редакция PII в conversations
# MINIO_SECURE=false              # HTTPS для MinIO
# QDRANT_HTTPS=false              # HTTPS + QDRANT_API_KEY для Qdrant
LOG_LEVEL=INFO

# --- Роли и наблюдаемость ---
WORKER_QUEUES=all              # query | background | all
METRICS_PORT=8000              # /healthz /readyz /metrics
OTEL_ENDPOINT=                 # OTLP exporter для трассировки (пусто = выкл)

# --- Генерация ---
LLM_TEMPERATURE=0.1
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_RESET_TIMEOUT=60

# --- Кэши (пустой REDIS_URL = in-process TTLCache) ---
REDIS_URL=
REDIS_CACHE_PREFIX=rag

# --- Поиск ---
SEARCH_HYBRID=false
SEARCH_HYBRID_RRF_K=60
SEARCH_HYBRID_CANDIDATES=50
# QDRANT_HNSW_M=32             # раскомментируйте для тюнинга HNSW
# QDRANT_HNSW_EF_CONSTRUCT=200
# QDRANT_HNSW_EF=128

# --- Парсинг / OCR ---
PDF_OCR_STRATEGY=auto          # auto | hi_res | ocr_only | fast
PDF_OCR_LANGUAGES=eng          # напр. eng,rus

# --- Эмбеддинги ---
EMBEDDING_QUERY_PREFIX=query: 
EMBEDDING_PASSAGE_PREFIX=passage: 
POSTGRES_READ_DSN=